---
// 共通レイアウト
import Header from "@common/Header.astro";
import Footer from "@common/Footer.astro";
import Analytics from "@common/Analytics.astro";

// サイトのメタ情報
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_FAVICON,
  GTM_ID,
  SITE_MAX_WIDTH,
} from "@/consts";

// グローバルスタイル（Constance風テーマ）
import "@styles/global.css";

interface Props {
  title?: string;
  description?: string;
  lang?: string; // 言語を外部から渡せるようにする
}

// いったん「生の説明」を取ってから、空白を整える
const rawTitle = Astro.props.title
  ? `${Astro.props.title} | Arca & Nemi`
  : SITE_TITLE;
const rawDescription = Astro.props.description ?? SITE_DESCRIPTION;

// 改行や連続スペースを1つのスペースにまとめて、前後の空白を削る
const title = rawTitle;
const description = rawDescription.replace(/\s+/g, " ").trim();

// デフォルト言語 = 英語
const lang = Astro.props.lang ?? "en";
---

<html lang={lang}>
  <head>
    <Analytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="icon" href={SITE_FAVICON} type="image/svg+xml" />
    <!-- 🔤 Kurale 読み込み（見出し用 serif フォント） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Kurale&family=Noto+Sans:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body style={`--site-max-width: ${SITE_MAX_WIDTH};`}>
    <!-- ========================= -->
    <!-- UNDER CONSTRUCTION MODE -->
    <!-- コメントアウトでON/OFFできる コメントアウトの形は、{/* ... */}-->
    {
      (
        <section class="fp-under-construction">
          <div class="fp-under-wrap">
            <h2>Under Construction</h2>

            <p class="fp-under-dialogue">
              Arca: “Wait just a bit! I'm still arranging things.”
              <br />
              Nemi: “Rushing creates bugs. Please check back soon.”
            </p>
          </div>
        </section>
      )
    }
    <!-- ========================= -->

    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src={"https://www.googletagmanager.com/ns.html?id=" + GTM_ID}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      >
      </iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <Header />

    <!-- ★ Constance 風の共通コンテナ -->
    <main class="fp-main">
      <slot />
    </main>

    <Footer />

    <!-- ★ fade-in と runner 用の軽量スクリプト -->
    <script is:inline>
      if (typeof window !== "undefined") {
        const fadeEls = document.querySelectorAll(".js-fade");

        // セクションのふわっと表示
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 },
        );

        fadeEls.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
