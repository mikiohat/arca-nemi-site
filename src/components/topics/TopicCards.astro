---
type Topic = {
    eyebrow?: string;
    title: string;
    description: string;
    episodeHref: string;
    playgroundHref?: string;
    tags?: string[];
};

const { topics } = Astro.props as { topics: Topic[] };
---

<div class="fp-cards">
    {
        topics.map((t) => (
            <article class="fp-card">
                {t.eyebrow && <p class="fp-kicker">{t.eyebrow}</p>}

                <h3 class="fp-card-title">{t.title}</h3>
                <p class="fp-card-desc">{t.description}</p>

                {t.tags?.length && <p class="fp-tags">{t.tags.join(" / ")}</p>}

                <p class="fp-links">
                    <a href={t.episodeHref}>Read Episode</a>
                    {t.playgroundHref && (
                        <>
                            <span class="fp-sep"> / </span>
                            <a href={t.playgroundHref}>Try in Playground</a>
                        </>
                    )}
                </p>
            </article>
        ))
    }
</div>

<style>
    .fp-cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1.25rem;
    }

    .fp-card {
        padding: 1.25rem;
        border-radius: 16px;
        background: rgba(15, 23, 42, 0.35);
        border: 1px solid rgba(148, 163, 184, 0.25);
    }

    .fp-kicker {
        font-size: 0.75rem;
        opacity: 0.8;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 0.25rem;
    }

    .fp-card-title {
        font-size: 1.05rem;
        margin: 0.25rem 0 0.5rem;
    }

    .fp-card-desc {
        font-size: 0.9rem;
        opacity: 0.9;
        line-height: 1.6;
    }

    .fp-tags {
        margin-top: 0.5rem;
        font-size: 0.75rem;
        opacity: 0.75;
    }

    .fp-links {
        margin-top: 0.75rem;
        font-size: 0.85rem;
    }

    .fp-sep {
        opacity: 0.6;
        padding: 0 0.25rem;
    }
</style>
