---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/nav/Breadcrumbs.astro";
import { formatLedgerNumber } from "@/utils/format";

type Episode = {
    slug: string;
    title: string;
    order: number;
    tags?: string[];
};

type Crumb = {
    label: string;
    href?: string;
};

type Props = {
    title: string;
    description?: string;
    heading: string;
    seriesSlug: string;
    episodes: Episode[];
    breadcrumbs: Crumb[];
    hideTag?: string;
};

const {
    title,
    description,
    heading,
    seriesSlug,
    episodes,
    breadcrumbs,
    hideTag = "SQL", // デフォルトで削除したいタグ
} = Astro.props as Props;
---

<BaseLayout title={title} description={description}>
    <main class="fp-main">
        <section class="fp-section js-fade episodes-index">
            <!-- ★ ここで Breadcrumbs -->
            <Breadcrumbs items={breadcrumbs} />

            <h1 class="fp-heading">{heading}</h1>

            <ul class="fp-list">
                {
                    episodes.map((episode) => {
                        const tags = episode.tags ?? [];
                        const visibleTags = [...new Set(tags)]
                            .map((t) => t.trim())
                            .filter(Boolean)
                            .filter((t) => t !== hideTag);

                        return (
                            <li>
                                <div class="fp-episode-item">
                                    <a
                                        class="fp-episode-link"
                                        href={`/episodes/${seriesSlug}/${episode.slug}`}
                                    >
                                        {formatLedgerNumber(episode.order)}:{" "}
                                        {episode.title}
                                    </a>

                                    {visibleTags.length > 0 && (
                                        <ul
                                            class="fp-tags"
                                            aria-label="Episode topics"
                                        >
                                            {visibleTags.map((tag) => (
                                                <li class="fp-tag">{tag}</li>
                                            ))}
                                        </ul>
                                    )}
                                </div>
                            </li>
                        );
                    })
                }
            </ul>
        </section>
    </main>
</BaseLayout>
