---
interface Props {
  speaker: "arca" | "nemi" | "narration";
  emotion?: "normal" | "happy" | "anger" | "sad" | "joy";
  peek?: string;
}

const { speaker, emotion = "normal", peek } = Astro.props;

const isNarration = speaker === "narration";
const hasFlip = !isNarration && !!peek;
const isRight = speaker === "arca";

const rowClass =
  speaker === "arca"
    ? "cb-row cb-row--right"
    : speaker === "nemi"
      ? "cb-row cb-row--left"
      : "cb-row cb-row--center";

const AVATAR_MAP = {
  arca: {
    normal: "/avatars/arca/normal.webp",
    happy: "/avatars/arca/happy.webp",
    anger: "/avatars/arca/anger.webp",
    sad: "/avatars/arca/sad.webp",
    joy: "/avatars/arca/joy.webp",
  },
  nemi: {
    normal: "/avatars/nemi/normal.webp",
    happy: "/avatars/nemi/happy.webp",
    anger: "/avatars/nemi/anger.webp",
    sad: "/avatars/nemi/sad.webp",
    joy: "/avatars/nemi/joy.webp",
  },
};

const avatarSrc = !isNarration ? AVATAR_MAP[speaker]?.[emotion] : null;
---

<div class={rowClass}>
  {
    hasFlip ? (
      <div class="flip-card">
        <div class="flip-inner">
          {/* Front face */}
          <div class={`flip-face flip-front${isRight ? " flip-face--right" : ""}`}>
            {avatarSrc && (
              <div class="cb-avatar" aria-hidden="true">
                <img
                  src={avatarSrc}
                  alt={speaker}
                  class="cb-avatar-img"
                  loading="lazy"
                />
              </div>
            )}
            <div class="cb-body">
              <div class="cb-text">
                <slot />
              </div>
              <button class="flip-btn" aria-label="Show peek">
                <svg
                  class="flip-btn-svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M7.5 7.5a7 7 0 0 1 11 2.5"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                  <path
                    d="M18.5 6.5v4h-4"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M16.5 16.5a7 7 0 0 1-11-2.5"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                  <path
                    d="M5.5 17.5v-4h4"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
            </div>
          </div>

          {/* Back face */}
          <div class={`flip-face flip-back${isRight ? " is-front-right" : ""}`}>
            {avatarSrc && (
              <img
                src={avatarSrc}
                alt=""
                class="peek-back-portrait"
                aria-hidden="true"
                loading="lazy"
              />
            )}
            <div class="cb-body">
              <p class="peek-back-text">{peek}</p>
              <button class="flip-btn flip-btn--back" aria-label="Back to dialogue">
                <svg
                  class="flip-btn-svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M7.5 7.5a7 7 0 0 1 11 2.5"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                  <path
                    d="M18.5 6.5v4h-4"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M16.5 16.5a7 7 0 0 1-11-2.5"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                  <path
                    d="M5.5 17.5v-4h4"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class={`cb ${isNarration ? "cb--narration" : ""}`}>
        {!isNarration && avatarSrc && (
          <div class="cb-avatar" aria-hidden="true">
            <img
              src={avatarSrc}
              alt={speaker}
              class="cb-avatar-img"
              loading="lazy"
            />
          </div>
        )}
        <div class="cb-body">
          <div class="cb-text">
            <slot />
          </div>
        </div>
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>(".flip-card").forEach((card) => {
    const inner = card.querySelector<HTMLElement>(".flip-inner");
    card.querySelectorAll<HTMLButtonElement>(".flip-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        inner?.classList.toggle("is-flipped");
      });
    });
  });
</script>

<style>
  /* ─── row layout ─────────────────────────────────────────── */

  .cb-row {
    display: flex;
    margin: 0.35rem 0;
  }

  .cb-row--left {
    justify-content: flex-start;
  }

  .cb-row--right {
    justify-content: flex-end;
  }

  .cb-row--center {
    justify-content: center;
  }

  /* ─── standard bubble (no flip) ──────────────────────────── */

  .cb {
    display: flex;
    align-items: center;
    flex-direction: row;
    gap: 0.55rem;
    max-width: min(100%, 560px);
    padding: 0.55rem 0.85rem;
    border-radius: 18px;
    border: 1px solid var(--fp-border-soft);
    background: var(
      --cb-bg,
      radial-gradient(
        circle at 0 0,
        var(--fp-card-background),
        transparent 55%
      ),
      var(--fp-background-shadow)
    );
    box-shadow: 0 10px 24px var(--fp-card-background-alt);
  }

  .cb-row--right .cb {
    flex-direction: row-reverse;
  }

  .cb--narration {
    max-width: 620px;
    border-radius: 999px;
    text-align: center;
  }

  /* ─── flip card ───────────────────────────────────────────── */

  .flip-card {
    perspective: 1000px;
    max-width: min(100%, 560px);
  }

  .flip-inner {
    position: relative;
    transform-style: preserve-3d;
    transition: transform 420ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .flip-inner.is-flipped {
    transform: rotateY(180deg);
  }

  /* ─── shared face styles ──────────────────────────────────── */

  .flip-face {
    backface-visibility: hidden;
    border-radius: 18px;
    border: 1px solid var(--fp-border-soft);
    box-shadow: 0 10px 24px var(--fp-card-background-alt);
  }

  /*
   * Belt-and-suspenders for mobile WebKit, where preserve-3d +
   * backface-visibility can flatten and leak the hidden face (and its
   * flip button). Swap visibility instantly at the rotate midpoint so
   * exactly one face is shown/clickable. The 210ms delay must stay in
   * sync with the 420ms .flip-inner transition above.
   */
  .flip-front,
  .flip-back {
    transition: opacity 0s linear 210ms;
  }

  .flip-inner:not(.is-flipped) .flip-back {
    opacity: 0;
    pointer-events: none;
  }

  .flip-inner.is-flipped .flip-front {
    opacity: 0;
    pointer-events: none;
  }

  /* ─── front face ──────────────────────────────────────────── */

  .flip-front {
    position: relative;
    display: flex;
    align-items: center;
    flex-direction: row;
    gap: 0.55rem;
    padding: 0.55rem 0.85rem 2.4rem;
    background: var(
      --cb-bg,
      radial-gradient(
        circle at 0 0,
        var(--fp-card-background),
        transparent 55%
      ),
      var(--fp-background-shadow)
    );
  }

  .flip-face--right {
    flex-direction: row-reverse;
  }

  /* ─── back face ───────────────────────────────────────────── */

  .flip-back {
    position: absolute;
    inset: 0;
    transform: rotateY(180deg);
    overflow-x: hidden;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    display: flex;
    align-items: flex-start;
    padding: 0.55rem 0.85rem 2.4rem;
    background:
      radial-gradient(
        ellipse at 50% 0%,
        rgba(99, 102, 241, 0.08) 0%,
        transparent 70%
      ),
      var(--fp-background-shadow);
  }

  /* ─── body (shared between front and back) ────────────────── */

  .cb-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }

  .cb-text {
    font-size: var(--fp-font-size-base);
    line-height: 1.7;
    color: var(--fp-text);
    word-wrap: break-word;
  }

  /* ─── peek back content ───────────────────────────────────── */

  .peek-back-text {
    position: relative;
    z-index: 1;
    margin: 0;
    flex: 1;
    font-size: 0.86rem;
    font-family: var(--fp-font-mono, monospace);
    color: var(--fp-text-muted, rgba(148, 163, 184, 0.92));
    line-height: 1.75;
    letter-spacing: 0.01em;
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* ─── back-side character portrait (subtle backdrop) ──────── */

  .peek-back-portrait {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 46%;
    max-width: 190px;
    height: auto;
    object-fit: contain;
    transform: scaleX(-1);
    filter: grayscale(1) contrast(1.05) brightness(0.85)
      drop-shadow(0 1px 0 rgba(255, 255, 255, 0.06));
    opacity: 0.22;
    pointer-events: none;
    z-index: 0;
  }

  /* ─── flip trigger button ─────────────────────────────────── */

  .flip-btn {
    position: absolute;
    right: 0.6rem;
    bottom: 0.55rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--fp-border-soft);
    background: rgba(148, 163, 184, 0.1);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: var(--fp-text-muted, rgba(148, 163, 184, 0.8));
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.18),
      inset 0 0 0 1px rgba(255, 255, 255, 0.04);
    cursor: pointer;
    transition:
      color 160ms ease,
      background 160ms ease,
      box-shadow 160ms ease;
  }

  .flip-btn:hover {
    color: var(--fp-accent);
    background: rgba(99, 102, 241, 0.16);
    box-shadow:
      0 4px 14px rgba(99, 102, 241, 0.22),
      inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .flip-btn:focus-visible {
    outline: none;
    color: var(--fp-accent);
    box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.5);
  }

  /* mirror only the icon, keep the button anchored bottom-right */
  .flip-btn--back .flip-btn-svg {
    transform: scaleX(-1);
  }

  /*
   * Back side mirrors the front: when the front character image sits on
   * the right (Arca), move the back button and portrait to the left so
   * the back feels like the reverse of the same card.
   */
  .flip-back.is-front-right .flip-btn--back {
    right: auto;
    left: 0.6rem;
  }

  .flip-back.is-front-right .peek-back-portrait {
    right: auto;
    left: 0;
  }

  .flip-btn-svg {
    width: 16px;
    height: 16px;
    display: block;
  }

  /* ─── avatar ──────────────────────────────────────────────── */

  .cb-avatar {
    flex: 0 0 auto;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    box-shadow: 0 2px 4px var(--fp-border-soft);
    transform: translateY(0) scale(1);
    transition:
      transform 170ms cubic-bezier(0.16, 1.1, 0.3, 1),
      box-shadow 170ms ease-out;
  }

  .cb-avatar:hover {
    transform: translateY(-1px) scale(2.5);
    box-shadow: 0 10px 24px var(--fp-card-background-alt);
  }

  .cb-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ─── responsive ──────────────────────────────────────────── */

  @media (max-width: 720px) {
    .cb-row {
      margin: 0.3rem 0;
    }

    .cb,
    .flip-face {
      border-radius: 16px;
    }

    .cb {
      max-width: 100%;
      padding: 0.5rem 0.75rem;
    }

    .flip-front,
    .flip-back {
      padding: 0.5rem 0.75rem 2.3rem;
    }

    .flip-back {
      padding-bottom: 2.6rem;
    }

    .cb-text {
      font-size: calc(var(--fp-font-size-base) * 0.88);
    }

    .peek-back-text {
      font-size: 0.82rem;
      line-height: 1.65;
    }
  }
</style>
