---
interface Props {
  speaker: "arca" | "nemi" | "narration";
  emotion?: "normal" | "happy" | "anger" | "sad" | "joy";
  peek?: string;
}

const { speaker, emotion = "normal", peek } = Astro.props;

// speaker から自動決定
const isNarration = speaker === "narration";
const align =
  speaker === "arca" ? "right" : speaker === "nemi" ? "left" : "center";

// class 決定
const rowClass =
  align === "right"
    ? "cb-row cb-row--right"
    : align === "left"
      ? "cb-row cb-row--left"
      : "cb-row cb-row--center";

// avatar（narration はなし）
const AVATAR_MAP = {
  arca: {
    normal: "/avatars/arca/normal.webp",
    happy: "/avatars/arca/happy.webp",
    anger: "/avatars/arca/anger.webp",
    sad: "/avatars/arca/sad.webp",
    joy: "/avatars/arca/joy.webp",
  },
  nemi: {
    normal: "/avatars/nemi/normal.webp",
    happy: "/avatars/nemi/happy.webp",
    anger: "/avatars/nemi/anger.webp",
    sad: "/avatars/nemi/sad.webp",
    joy: "/avatars/nemi/joy.webp",
  },
};

const avatarSrc = !isNarration ? AVATAR_MAP[speaker]?.[emotion] : null;
---

<div class={rowClass}>
  <div class={`cb ${isNarration ? "cb--narration" : ""}`}>
    {
      !isNarration && avatarSrc && (
        <div class="cb-avatar" aria-hidden="true">
          <img
            src={avatarSrc}
            alt={speaker}
            class="cb-avatar-img"
            loading="lazy"
          />
        </div>
      )
    }

    <div class="cb-body">
      <div class="cb-text">
        <slot />
      </div>
      {
        !isNarration && peek && (
          <details class="peek">
            <summary class="peek-trigger">peek</summary>
            <p class="peek-content">{peek}</p>
          </details>
        )
      }
    </div>
  </div>
</div>

<style>
  .cb-row {
    display: flex;
    margin: 0.35rem 0;
  }

  .cb-row--left {
    justify-content: flex-start;
  }

  .cb-row--right {
    justify-content: flex-end;
  }

  .cb-row--center {
    justify-content: center;
  }

  .cb {
    display: flex;
    align-items: center;
    flex-direction: row;
    gap: 0.55rem;
    max-width: min(100%, 560px);
    padding: 0.55rem 0.85rem;
    border-radius: 18px;
    border: 1px solid var(--fp-border-soft);

    /* ★ ここを CSS 変数経由にして、背景を優先順位で切り替え */
    background: var(
      --cb-bg,
      radial-gradient(
        circle at 0 0,
        var(--fp-card-background),
        transparent 55%
      ),
      var(--fp-background-shadow)
    );
    box-shadow: 0 10px 24px var(--fp-card-background-alt);
  }

  .cb-row--right .cb {
    flex-direction: row-reverse;
  }

  .cb--narration {
    max-width: 620px;
    border-radius: 999px;
    text-align: center;
  }

  /* ★ 四角いアバター（角丸） */
  .cb-avatar {
    flex: 0 0 auto;
    width: 52px;
    height: 52px;
    border-radius: 14px; /* 0 にすれば完全な四角 */
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    box-shadow: 0 2px 4px var(--fp-border-soft);
    /* box-shadow: 0 2px 4px rgba(51, 63, 90, 0.9); */

    /* ★ ホバー用のアニメーション準備 */
    transform: translateY(0) scale(1);
    transition:
      transform 170ms cubic-bezier(0.16, 1.1, 0.3, 1),
      box-shadow 170ms ease-out;
  }

  /* アイコンに hover したとき、大きく＆影を強く */
  .cb-avatar:hover {
    transform: translateY(-1px) scale(2.5); /* 1.05〜1.10 くらいで調整 */
    box-shadow: 0 10px 24px var(--fp-card-background-alt);
  }

  .cb-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cb-body {
    min-width: 0;
  }

  .cb-text {
    font-size: var(--fp-font-size-base);

    line-height: 1.7;
    color: var(--fp-text);
    word-wrap: break-word;
  }

  @media (max-width: 720px) {
    .cb-row {
      margin: 0.3rem 0;
    }

    .cb {
      max-width: 100%;
      padding: 0.5rem 0.75rem;
      border-radius: 16px;
    }

    .cb-text {
      font-size: calc(var(--fp-font-size-base) * 0.88);
    }
  }
</style>
