---
import HeaderLink from "@common/HeaderLink.astro";

const NAV = [
  { href: "/", label: "Home" },
  { href: "/episodes", label: "Episodes" },
  { href: "/playground", label: "Playground" },
  { href: "/about", label: "About" },
];
---

<header class="fp-header">
  <div class="fp-header-inner">
    <a href="/" class="fp-logo"> feelings💙projects </a>
    <nav class="fp-nav" aria-label="Primary navigation">
      {
        NAV.map((item) => (
          <HeaderLink href={item.href}>{item.label}</HeaderLink>
        ))
      }
    </nav>
  </div>
</header>
