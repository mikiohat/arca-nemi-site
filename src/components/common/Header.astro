---
import { SITE_FAVICON } from "@/consts";

const { pathname } = Astro.url;

// 日本語ページかどうか判定（/ja ではじまるか）
const isJa = pathname.startsWith("/ja");

// 英語側のURL（/ja を外したもの）
const enPath = isJa
  ? pathname === "/ja"
    ? "/"
    : pathname.replace(/^\/ja/, "")
  : pathname;

// 日本語側のURL（先頭に /ja をつけたもの）
const jaPath = isJa ? pathname : "/ja" + (pathname === "/" ? "" : pathname);

const NAV = [
  { href: "/topics", label: "Topics" },
  { href: "/about", label: "About" },
];
---

<header class="fp-header">
  <div class="fp-header-inner">
    {/* Logo */}
    <a href="/" class="fp-logo">
      <img
        src={SITE_FAVICON}
        alt="Arca & Nemi"
        class="fp-logo-icon"
        loading="lazy"
      />
      <span>Arca &amp; Nemi</span>
    </a>

    <div class="fp-header-right">
      {/* Nav */}
      <nav class="fp-nav" aria-label="Primary navigation">
        {
          NAV.map((item) => (
            <a href={item.href} data-astro-prefetch class="link-underline">
              {item.label}
            </a>
          ))
        }
      </nav>

      {/* Language switcher (kept as-is) */}
      <details class="fp-lang-switch">
        <summary aria-label="Change language">
          <svg
            class="fp-lang-icon-svg"
            viewBox="0 0 24 24"
            role="img"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <ellipse cx="12" cy="12" rx="4.5" ry="9"></ellipse>
            <path d="M12 3v18"></path>
            <path d="M3 12h18"></path>
            <path d="M4.5 8.5h15"></path>
            <path d="M4.5 15.5h15"></path>
          </svg>
        </summary>

        <ul class="fp-lang-menu">
          <li><a href={enPath}>English</a></li>
          <li><a href={jaPath}>日本語</a></li>
        </ul>
      </details>
    </div>
  </div>
</header>
