---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href = "/", class: className, ...props } = Astro.props as Props;

// --- helpers ---
const normalize = (p: string) => (p !== "/" ? p.replace(/\/+$/, "") : "/");
const stripJa = (p: string) => p.replace(/^\/ja(?=\/|$)/, "") || "/";

// BASE_URL を安全に剥がす（"/" のときは剥がさない）
const stripBase = (p: string) => {
	const baseRaw = import.meta.env.BASE_URL ?? "/";
	const base = baseRaw !== "/" ? baseRaw.replace(/\/+$/, "") : "";

	if (base && p.startsWith(base)) {
		const sliced = p.slice(base.length);
		return sliced === ""
			? "/"
			: sliced.startsWith("/")
				? sliced
				: `/${sliced}`;
	}
	return p;
};

// pathname を正規化
const pathname = normalize(stripJa(stripBase(Astro.url.pathname)));

// href を string に正規化してから正規化
const rawHref =
	typeof href === "string" ? href : href instanceof URL ? href.pathname : "/";

const linkHref = normalize(stripJa(stripBase(rawHref)));

let isActive = false;

// Home
if (linkHref === "/") {
	isActive = pathname === "/";
}
// Topics： /topics と /topics/* すべて
else if (linkHref === "/topics") {
	isActive = pathname === "/topics" || pathname.startsWith("/topics/");
}
// Episodes： /episodes と /episodes/* すべて
else if (linkHref === "/episodes") {
	isActive = pathname === "/episodes" || pathname.startsWith("/episodes/");
}
// Playground： /playground と /playground/* すべて
else if (linkHref === "/playground") {
	isActive =
		pathname === "/playground" || pathname.startsWith("/playground/");
}
// その他：完全一致 or 配下
else {
	isActive =
		pathname === linkHref ||
		(linkHref !== "/" && pathname.startsWith(linkHref + "/"));
}
---

<a
	href={href}
	data-astro-prefetch
	class:list={["fp-navlink", className, { active: isActive }]}
	{...props}
>
	<slot />
</a>
