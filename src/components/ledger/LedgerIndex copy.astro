---
import type { LedgerUnit } from "@/content/ledger/sql";

type Props = {
  topicSlug: string; // "sql"
  ledgers: LedgerUnit[];
  hideTag?: string; // default: "SQL"
};

const { topicSlug, ledgers, hideTag = "SQL" } = Astro.props as Props;

const uniqueVisibleTags = (tags: string[] | undefined) => {
  const t = tags ?? [];
  return [...new Set(t)]
    .map((x) => x.trim())
    .filter(Boolean)
    .filter((x) => x !== hideTag);
};

const episodeHref = (slug: string) => `/topics/${topicSlug}/episode/${slug}`;
const playgroundHref = (slug: string) =>
  `/topics/${topicSlug}/playground/${slug}`;
---

<ul class="ledger" aria-label="Ledger list">
  {
    ledgers.map((ledger) => {
      const visibleTags = uniqueVisibleTags(ledger.tags);

      return (
        <li class="ledger__item">
          <div class="ledger__row">
            <p class="ledger__title">
              {String(ledger.order).padStart(2, "0")}: {ledger.title}
            </p>

            <details class="ledger__actions">
              <summary class="ledger__trigger" aria-label="Open actions">
                <span class="ledger__trigger-pill" aria-hidden="true">
                  <span class="fp-chevron" />
                </span>
              </summary>

              <ul class="ledger__menu" aria-label="Actions">
                <li>
                  <a class="ledger__menu-link" href={episodeHref(ledger.slug)}>
                    Read Episode
                  </a>
                </li>
                <li>
                  <a
                    class="ledger__menu-link"
                    href={playgroundHref(ledger.slug)}
                  >
                    Try Playground
                  </a>
                </li>
              </ul>
            </details>
          </div>

          {visibleTags.length > 0 && (
            <ul class="ledger__tags" aria-label="Ledger topics">
              {visibleTags.map((tag) => (
                <li class="ledger__tag">{tag}</li>
              ))}
            </ul>
          )}
        </li>
      );
    })
  }
</ul>

<script>
  document.addEventListener("click", (e) => {
    const target = e.target;
    if (!(target instanceof Element)) return;

    // ① メニュー内リンクをクリック → そのメニューだけ閉じる
    const menuLink = target.closest(".ledger__menu-link");
    if (menuLink) {
      const details = menuLink.closest(".ledger__actions");
      if (details instanceof HTMLDetailsElement) {
        details.removeAttribute("open");
      }
      return;
    }

    // ② メニュー外をクリック → 開いてるメニューを全部閉じる
    document.querySelectorAll(".ledger__actions[open]").forEach((d) => {
      if (d instanceof HTMLDetailsElement) {
        d.removeAttribute("open");
      }
    });
  });

  // ③ Escape キーで閉じる（そのままでOK）
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;

    document.querySelectorAll(".ledger__actions[open]").forEach((d) => {
      if (d instanceof HTMLDetailsElement) {
        d.removeAttribute("open");
      }
    });

    const active = document.activeElement;
    if (active instanceof HTMLElement) active.blur();
  });
</script>

<style>
  /* =========================
   LedgerIndex (scoped)
========================= */

  /* ---------- list / layout ---------- */
  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
    --ledger-indent: 1.2rem;
  }

  .ledger__menu,
  .ledger__tags {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ledger__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0.2rem 0;
    margin-bottom: 0.5rem;
  }

  .ledger__row {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.8rem;
  }

  /* ---------- title ---------- */
  .ledger__title {
    position: relative;
    padding-left: var(--ledger-indent);
    margin: 0;
    font-size: calc(var(--fp-font-size-base) * 1.042);
    font-weight: 500;
    line-height: 1.4;
  }

  .ledger__title::before {
    content: "✦";
    position: absolute;
    left: 0;
    top: 0.15em;
    opacity: 0.6;
    line-height: 1;
  }

  /* ---------- tags ---------- */
  .ledger__tags {
    width: 100%;
    margin-top: 0.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;

    padding-left: calc(var(--ledger-indent) - 0.2rem);
    font-size: calc(var(--fp-font-size-base) * 0.542);
    color: var(--fp-muted);
  }

  .ledger__tag {
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--fp-border-faint);
  }

  /* ---------- actions (layers + trigger) ---------- */
  .ledger__actions {
    position: relative;
    z-index: 1; /* base layer */
  }

  .ledger__actions[open] {
    z-index: 50; /* active row layer */
  }

  .ledger__trigger {
    list-style: none;
    cursor: pointer;
  }
  .ledger__trigger::-webkit-details-marker {
    display: none;
  }

  .ledger__trigger-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 1.55rem;
    border-radius: 999px;
    border: 1px solid var(--fp-border-soft);
    font-size: calc(var(--fp-font-size-base) * 0.792);
    color: var(--fp-accent);
  }

  .ledger__trigger:hover .ledger__trigger-pill,
  .ledger__trigger:focus-visible .ledger__trigger-pill {
    background: var(--fp-border-faint);
    border-color: var(--fp-border);
  }

  /* ---------- menu (visual + motion) ---------- */
  .ledger__menu {
    position: absolute;
    right: 0;

    /* 下に出すのをやめる */
    top: auto;

    /* 常に上に出す */
    bottom: calc(100% + 0.35rem);

    min-width: unset;
    width: fit-content;
    padding: 0.35rem;
    border-radius: 14px;
    border: none;
    box-shadow: inset 0 0 0 1px var(--fp-border-faint);
    background: var(--fp-card-background-alt);

    z-index: 60;

    opacity: 0;
    pointer-events: none;

    /* 上に出る前提なので +4px が自然 */
    transform: translateY(4px);

    transition:
      opacity 140ms ease,
      transform 140ms ease;
  }

  .ledger__actions[open] .ledger__menu {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* hover がある端末だけ hover-open */
  @media (hover: hover) and (pointer: fine) {
    .ledger__actions:hover .ledger__menu {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }
  }

  /* ---------- menu links ---------- */
  .ledger__menu-link {
    display: block;
    padding: 0.6rem 0.65rem;
    border-radius: 12px;
    font-size: calc(var(--fp-font-size-base) * 0.708);
    text-decoration: none;
    white-space: nowrap;
  }

  .ledger__menu-link:hover,
  .ledger__menu-link:focus-visible {
    background: rgba(184, 148, 164, 0.12);
  }

  /* ---------- tap highlight kill (Android) ---------- */
  .ledger__trigger,
  .ledger__trigger-pill,
  .ledger__menu-link {
    -webkit-tap-highlight-color: transparent;
  }

  .ledger__trigger:active,
  .ledger__menu-link:active {
    background: transparent;
  }

  .ledger__trigger:focus {
    outline: none;
  }

  .ledger__trigger:focus-visible .ledger__trigger-pill {
    outline: 2px solid var(--fp-accent);
    outline-offset: 2px;
  }

  .ledger__menu-link:focus-visible {
    outline: 2px solid var(--fp-accent);
    outline-offset: 2px;
    border-radius: 12px;
  }
</style>
