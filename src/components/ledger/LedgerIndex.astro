---
import type { LedgerUnit } from "@/content/ledger/sql";

type Props = {
  topicSlug: string; // "sql"
  ledgers: LedgerUnit[];
  hideTag?: string; // default: "SQL"
};

const { topicSlug, ledgers, hideTag = "SQL" } = Astro.props as Props;

const uniqueVisibleTags = (tags: string[] | undefined) => {
  const t = tags ?? [];
  return [...new Set(t)]
    .map((x) => x.trim())
    .filter(Boolean)
    .filter((x) => x !== hideTag);
};

const storyHref = (slug: string) => `/topics/${topicSlug}/stories/${slug}`;
---

<ul class="ledger" aria-label="Ledger list">
  {
    ledgers.map((ledger) => {
      const visibleTags = uniqueVisibleTags(ledger.tags);

      return (
        <li class="ledger__item">
          <div class="ledger__row">
            <p class="ledger__title">
              {String(ledger.order).padStart(2, "0")}: {ledger.title}
            </p>

            <a
              class="ledger__open"
              href={storyHref(ledger.slug)}
              aria-label={`Open story: ${ledger.title}`}
            >
              <span class="fp-chevron" aria-hidden="true" />
            </a>
          </div>

          {visibleTags.length > 0 && (
            <ul class="ledger__tags" aria-label="Ledger topics">
              {visibleTags.map((tag) => (
                <li class="ledger__tag">{tag}</li>
              ))}
            </ul>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  /* =========================
   LedgerIndex (scoped)
========================= */

  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
    --ledger-indent: 1.2rem;
  }

  .ledger__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0.2rem 0;
    margin-bottom: 0.5rem;
  }

  .ledger__row {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.8rem;
  }

  .ledger__title {
    position: relative;
    padding-left: var(--ledger-indent);
    margin: 0;
    font-size: calc(var(--fp-font-size-base) * 1.042);
    font-weight: 500;
    line-height: 1.4;
  }

  .ledger__title::before {
    content: "✦";
    position: absolute;
    left: 0;
    top: 0.15em;
    opacity: 0.6;
    line-height: 1;
  }

  .ledger__tags {
    list-style: none;
    width: 100%;
    margin: 0.2rem 0 0;
    padding-left: calc(var(--ledger-indent) - 0.2rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;

    font-size: calc(var(--fp-font-size-base) * 0.542);
    color: var(--fp-muted);
  }

  .ledger__tag {
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--fp-border-faint);
  }

  /* ===== open-story: subtle circular icon button ===== */
  .ledger__open {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 1.55rem;
    border-radius: 999px;
    border: 1px solid var(--fp-border-soft);
    color: var(--fp-accent);
    text-decoration: none;

    transition:
      background 140ms ease,
      border-color 140ms ease;
  }

  .ledger__open:hover,
  .ledger__open:focus-visible {
    background: var(--fp-border-faint);
    border-color: var(--fp-border);
  }

  .ledger__open:focus-visible {
    outline: 2px solid var(--fp-accent);
    outline-offset: 2px;
  }

  /* right-facing chevron, centered in the pill */
  .ledger__open .fp-chevron {
    margin-left: 0;
  }
</style>
