---
export type Crumb = {
    label: string;
    href?: string; // 現在地は href なし
};

type Props = {
    items: Crumb[];
};

const { items } = Astro.props as Props;
---

<nav class="fp-breadcrumb" aria-label="Breadcrumb">
    <ol class="fp-breadcrumb-list">
        {
            items.map((item, i) => {
                const isLast = i === items.length - 1;

                // 最後 or hrefなし → 現在地扱い（リンクにしない）
                if (isLast || !item.href) {
                    return (
                        <li class="fp-breadcrumb-item">
                            <span
                                class="fp-breadcrumb-current"
                                aria-current="page"
                            >
                                {item.label}
                            </span>
                        </li>
                    );
                }

                return (
                    <li class="fp-breadcrumb-item">
                        <a class="fp-breadcrumb-link" href={item.href}>
                            {item.label}
                        </a>
                        <span class="fp-breadcrumb-sep" aria-hidden="true">
                            /
                        </span>
                    </li>
                );
            })
        }
    </ol>
</nav>
