---
type SwitchItem = {
  label: string;
  href: string;
};

type Props = {
  left: SwitchItem | null;
  right: SwitchItem | null;
  active: "left" | "right";
};

const { left, right, active } = Astro.props;

// show only the opposite side
const target = active === "left" ? right : left;
const targetLabel = active === "left" ? "Playground" : "Episode";
---

{
  target ? (
    <nav class="sw-switcher" aria-label="Episode / Playground switcher">
      <a class="sw-item" href={target.href}>
<span class="sw-icon" aria-hidden="true">
  <svg class="sw-icon-svg" viewBox="0 0 24 24" fill="none">
    <!-- circular arrows -->
    <path
      d="M7.5 7.5a7 7 0 0 1 11 2.5"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    />
    <path
      d="M18.5 6.5v4h-4"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <path
      d="M16.5 16.5a7 7 0 0 1-11-2.5"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    />
    <path
      d="M5.5 17.5v-4h4"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</span>
        <span class="sw-text">{target.label}</span>
      </a>
    </nav>
  ) : null
}

<style>
  .sw-switcher {
    position: fixed;
    bottom: 16px;
    right: max(16px, calc((100vw - var(--site-max-width)) / 2 + 16px));
    z-index: 40;
  }

  .sw-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;

    inline-size: 150px;
    padding: 8px 12px;
    border-radius: 9999px;

    text-decoration: none;
    color: var(--fp-muted);

    /* keep transparency, add presence */
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(148, 163, 184, 0.35);
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.45);
    backdrop-filter: blur(8px);

    white-space: nowrap;
  }

  .sw-text {
    text-align: center;
    font-size: calc(var(--fp-font-size-base) * 0.76);
  }
  .sw-icon {
    position: absolute;
    left: 12px; /* アイコンは左に固定 */
    opacity: 0.9;
    line-height: 1;
  }

  .sw-icon-svg {
  width: 16px;
  height: 16px;
  display: block;
}


  /* subtle hover (desktop) */
  .sw-item:hover {
    background: rgba(255, 255, 255, 0.085);
    border-color: rgba(148, 163, 184, 0.5);
  }
</style>
