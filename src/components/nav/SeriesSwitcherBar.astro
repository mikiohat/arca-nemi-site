---
type Mode = "episodes" | "playground";

interface Props {
    seriesLabel: string; // e.g. "FEELINGS 💙 SQL"
    seriesHref: string; // e.g. "/episodes/feelings-sql" or "/playground/feelings-sql" (あなたのハブ定義に合わせる)
    mode: Mode; // current mode
    episodesHref: string; // e.g. "/episodes/feelings-sql"
    playgroundHref: string; // e.g. "/playground/feelings-sql"
}

const { seriesLabel, seriesHref, mode, episodesHref, playgroundHref } =
    Astro.props;
---

<nav class="fp-seriesbar" aria-label="Series navigation">
    <a class="fp-seriesbar__series" href={seriesHref}>
        {seriesLabel}
    </a>

    <div class="fp-seriesbar__divider" aria-hidden="true"></div>

    <div class="fp-seriesbar__modes">
        <a
            class:list={[
                "fp-seriesbar__link",
                mode === "episodes" && "is-active",
            ]}
            href={episodesHref}
            aria-current={mode === "episodes" ? "page" : undefined}
        >
            Episodes
        </a>
        <a
            class:list={[
                "fp-seriesbar__link",
                mode === "playground" && "is-active",
            ]}
            href={playgroundHref}
            aria-current={mode === "playground" ? "page" : undefined}
        >
            Playground
        </a>
    </div>
</nav>

<style>
    .fp-seriesbar {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border-radius: 14px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(10px);
    }
    .fp-seriesbar__series {
        font-weight: 600;
        text-decoration: none;
        color: inherit;
        white-space: nowrap;
    }
    .fp-seriesbar__divider {
        width: 1px;
        height: 18px;
        background: rgba(255, 255, 255, 0.14);
    }
    .fp-seriesbar__modes {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }
    .fp-seriesbar__link {
        text-decoration: none;
        color: rgba(255, 255, 255, 0.72);
        padding: 6px 10px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.02);
        font-size: 0.95rem;
    }
    .fp-seriesbar__link.is-active {
        color: rgba(255, 255, 255, 0.95);
        border-color: rgba(255, 255, 255, 0.22);
        background: rgba(255, 255, 255, 0.06);
    }
</style>
