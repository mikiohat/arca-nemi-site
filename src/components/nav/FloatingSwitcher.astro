---
type SwitchItem = {
  label: string;
  href: string;
};

type Props = {
  left: SwitchItem | null;
  right: SwitchItem | null;
  active: "left" | "right";
};

const { left, right, active } = Astro.props;

// show only the opposite side
const target = active === "left" ? right : left;
---

{
  target ? (
    <>
      <nav
        id="sw-switcher"
        class="sw-switcher"
        aria-label="Episode / Playground switcher"
      >
        <a class="sw-item" href={target.href}>
          <span class="sw-icon" aria-hidden="true">
            <svg class="sw-icon-svg" viewBox="0 0 24 24" fill="none">
              <path
                d="M7.5 7.5a7 7 0 0 1 11 2.5"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
              <path
                d="M18.5 6.5v4h-4"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M16.5 16.5a7 7 0 0 1-11-2.5"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
              <path
                d="M5.5 17.5v-4h4"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </a>
      </nav>
    </>
  ) : null
}

<style>
  .sw-switcher {
    position: fixed;
    bottom: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 40;
  }

  .sw-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;

    inline-size: 32px;
    block-size: 32px;
    padding: 0;
    border-radius: 9999px;

    text-decoration: none;
    color: var(--fp-accent);

    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(148, 163, 184, 0.35);
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.45);
    backdrop-filter: blur(8px);

    white-space: nowrap;
  }

  .sw-icon {
    opacity: 0.9;
    line-height: 1;
  }

  .sw-icon-svg {
    width: 16px;
    height: 16px;
    display: block;
  }

  /* subtle hover (desktop) */
  .sw-item:hover {
    /* 枠の太さ */
    border: 1px solid transparent;

    /* 2レイヤー背景で擬似ボーダー */
    background:
    /* 内側（塗り） */
      linear-gradient(#0b1220, #0b1220) padding-box,
      /* 枠（グラデーション） */ linear-gradient(to right, #a5b4fc, #f472b6)
        border-box;

    color: var(--fp-muted);
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.35);
  }
</style>
