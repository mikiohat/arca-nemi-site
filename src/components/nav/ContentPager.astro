---
type PagerItem = { href: string; title: string };
type TopItem = { href: string; label: string };

type Props = {
  prev?: PagerItem | null;
  next?: PagerItem | null;
  top?: TopItem | null;
};

const { prev = null, next = null, top = null } = Astro.props as Props;
---

<nav class="cp-content-pager" aria-label="Content navigation">
  <div class="cp-content-pager-row">
    <div class="cp-content-pager-left">
      {
        prev && (
          <a class="cp-content-pager-item link-underline" href={prev.href}>
            {"< Prev"}
          </a>
        )
      }
    </div>

    <div class="cp-content-pager-center">
      {
        top && (
          <a class="cp-content-pager-item link-underline" href={top.href}>
            {top.label}
          </a>
        )
      }
    </div>

    <div class="cp-content-pager-right">
      {
        next && (
          <a class="cp-content-pager-item link-underline" href={next.href}>
            {"Next >"}
          </a>
        )
      }
    </div>
  </div>
</nav>

<style>
  .cp-content-pager {
    margin-top: 2.25rem;
  }

  .cp-content-pager-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    column-gap: 14px;
  }

  .cp-content-pager-left {
    justify-self: start;
  }
  .cp-content-pager-center {
    justify-self: center;
  }
  .cp-content-pager-right {
    justify-self: end;
  }

  .cp-content-pager-item {
    font-size: calc(var(--fp-font-size-base) * 0.76);
    color: var(--fp-muted);
    text-decoration: none;
    white-space: nowrap;
  }
</style>
