---
type Tab = "episodes" | "playground";

interface Props {
    current: Tab;
    episodesHref: string;
    playgroundHref: string;
    // 任意：表示ラベルを変えたいとき
    episodesLabel?: string;
    playgroundLabel?: string;
}

const {
    current,
    episodesHref,
    playgroundHref,
    episodesLabel = "Episodes",
    playgroundLabel = "Playground",
} = Astro.props;
---

<nav class="fp-tabs" aria-label="View switcher">
    <a
        class:list={["fp-tab", current === "episodes" && "is-active"]}
        href={episodesHref}
        aria-current={current === "episodes" ? "page" : undefined}
    >
        {episodesLabel}
    </a>

    <a
        class:list={["fp-tab", current === "playground" && "is-active"]}
        href={playgroundHref}
        aria-current={current === "playground" ? "page" : undefined}
    >
        {playgroundLabel}
    </a>
</nav>

<style>
    .fp-tabs {
        display: inline-flex;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.03);
        overflow: hidden;
        backdrop-filter: blur(10px);
    }
    .fp-tab {
        padding: 8px 14px;
        text-decoration: none;
        color: rgba(255, 255, 255, 0.72);
        font-weight: 600;
        border-right: 1px solid rgba(255, 255, 255, 0.1);
        font-size: 0.95rem;
        white-space: nowrap;
    }
    .fp-tab:last-child {
        border-right: none;
    }
    .fp-tab.is-active {
        color: rgba(255, 255, 255, 0.95);
        background: rgba(255, 255, 255, 0.07);
    }
</style>
