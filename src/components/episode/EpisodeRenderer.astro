---
import ConversationBubble from "@talk/ConversationBubble.astro";
import type { LedgerUnit } from "@/content/ledger/sql";
import type { EpisodeLine } from "@/content/scripts/types";

type Props = {
  ledger: LedgerUnit;
  lines: EpisodeLine[];
};

const { ledger, lines } = Astro.props as Props;
---

<h1 class="fp-title">{ledger.title}</h1>
{
  ledger.episode?.subtitle && (
    <p class="fp-subtitle">{ledger.episode.subtitle}</p>
  )
}

{
  lines.map((l) => (
    <ConversationBubble speaker={l.speaker} emotion={l.emotion}>
      {l.text}
    </ConversationBubble>
  ))
}
