---
import EpisodesIndex from "@/components/episodes/EpisodesIndex.astro";
import { sqlEpisodes } from "@/content/sqlEpisodes";
import { SERIES } from "@/consts/series";
---

<!-- src/pages/episodes/feelings-sql/index.astro -->
<EpisodesIndex
    title={SERIES.FEELINGS_SQL.title}
    description={SERIES.FEELINGS_SQL.description}
    heading="A slightly off-kilter SQL love log"
    seriesSlug={SERIES.FEELINGS_SQL.slug}
    episodes={sqlEpisodes}
    hideTag="SQL"
    breadcrumbs={[
        { label: "Home", href: "/" },
        { label: "Episodes", href: "/episodes" },
        { label: SERIES.FEELINGS_SQL.title },
    ]}
/>
