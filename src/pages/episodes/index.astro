---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SERIES } from "@/consts/series";
---

<!-- src/pages/episodes/index.astro -->
<BaseLayout title="Episodes">
    <main class="fp-main">
        <section class="fp-section js-fade">
            <p class="fp-kicker">
                <a href="/">Home</a> / Episodes
            </p>
            <div class="fp-cards">
                <!-- SQL -->
                <article class="fp-card">
                    <h1 class="fp-heading">{SERIES.FEELINGS_SQL.title}</h1>

                    <p>
                        A slightly off-kilter love log, told through SQL.
                        Emotions rarely behave as specified.
                    </p>

                    <p>
                        <a href=`/episodes/${SERIES.FEELINGS_SQL.slug}`
                            >Explore SQL Episodes →</a
                        >
                    </p>
                </article>

                <!-- Python -->
                <article class="fp-card">
                    <h1 class="fp-heading">{SERIES.FEELINGS_PYTHON.title}</h1>

                    <p>
                        Arca can’t stop thinking about sweet treats. So it
                        starts defining the world with Python.
                    </p>

                    <p class="fp-muted">Coming soon…</p>
                </article>

                <!-- Data Design -->
                <article class="fp-card">
                    <h1 class="fp-heading">Data-Oriented App Design</h1>

                    <p>
                        Design as responsibility. How structure, rules, and
                        ownership shape human systems.
                    </p>

                    <p class="fp-muted">Coming soon…</p>
                </article>
            </div>
        </section>
    </main>
</BaseLayout>
