---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<!-- src/pages/index.astro -->
<BaseLayout>
    {/* HERO */}
    <section class="fp-section fp-hero js-fade" id="top">
        <div class="fp-hero-inner">
            <p class="fp-kicker">A conversation between feelings and logic.</p>

            <h1 class="fp-title">
                feelings 💙 projects
                <span>
                    For practitioners who move with intention and live with
                    philosophy.
                </span>
            </h1>

            <p class="fp-lead">
                In a data-driven world, we value “human warmth” and thoughtful
                practice.
            </p>

            <a href="#story" class="fp-cta">Start with the Story</a>
        </div>
    </section>

    {/* INTRODUCTION: About this site */}
    <section class="fp-section fp-intro js-fade" id="about-site">
        <div class="fp-intro-inner">
            <h2 class="fp-heading">About this site</h2>

            <p class="fp-body">
                This site is the home of Arca and Nemi within feelings 💙
                projects. Here, they play with, work with, and gently guide you
                through tools like SQL, Python, and more — starting with SQL, of
                course.
            </p>

            <p class="fp-body">
                Through their banter, you can explore data, code, and
                decision-making without losing human warmth or your own way of
                thinking.
            </p>
        </div>
    </section>

    {/* STORY / AI is a partner */}
    <section id="story" class="fp-section fp-section-alt js-fade">
        <div class="fp-section-inner">
            <h2 class="fp-heading">
                AI is a partner — that’s why we still need to learn.
            </h2>
            <p>
                Late at night in the office, buried under a mountain of query
                logs, Nemi suddenly pauses and wonders, “Why… does this feel so
                exhausting?”
            </p>
            <p>
                Just then, someone pops out from deep inside the monitor— Arca,
                the AI girl who embodies emotion.
            </p>
        </div>
    </section>

    {/* CAST / Who are Arca & Nemi? */}
    <section id="cast" class="fp-section js-fade">
        <div class="fp-section-inner">
            <h2 class="fp-heading">Who are Arca &amp; Nemi?</h2>

            <div class="fp-cards fp-cards--character">
                <!-- Arca -->
                <article class="fp-card fp-card--character">
                    <img
                        src="/assets/arca_full.webp"
                        alt="Arca illustration"
                        class="fp-character-img"
                        loading="lazy"
                    />
                    <div class="fp-character-body">
                        <h3 class="fp-heading">Arca</h3>
                        <p>
                            An AI girl who governs emotion and impulse. Acts
                            before she thinks. Skilled at giving language to the
                            “emotional noise” hidden in data.
                        </p>
                    </div>
                </article>

                <!-- Nemi -->
                <article class="fp-card fp-card--character">
                    <img
                        src="/assets/nemi_full.webp"
                        alt="Nemi illustration"
                        class="fp-character-img"
                        loading="lazy"
                    />
                    <div class="fp-character-body">
                        <h3 class="fp-heading">Nemi</h3>
                        <p>
                            A warm-hearted, logic-driven engineer. She organizes
                            the world with reason, yet somehow always delivers
                            the gentlest punchlines.
                        </p>
                    </div>
                </article>
            </div>
        </div>
    </section>

    {/* TOPICS */}
    <section id="topics" class="fp-section fp-section-alt js-fade">
        <div class="fp-section-inner">
            <h2 class="fp-heading">Topics</h2>
            <p>
                First, enjoy Arca and Nemi’s silly conversations. Then, with one
                click, try the SQL yourself.
            </p>

            <div class="fp-cards">
                <article class="fp-card">
                    <h3 class="fp-heading">
                        Episode 1: SQL Begins with a Question
                    </h3>
                    <p>
                        A late-night debugging session sparked by “Why is this
                        query so slow?”
                    </p>
                    <p>
                        <a href="/episodes/episode-1">Read the Episode</a> ／
                        <a href="/playground/episode-1">Try in Playground</a>
                    </p>
                </article>

                <article class="fp-card">
                    <h3 class="fp-heading">
                        Episode 2: I Wish I Could ROLLBACK My Cringe Moments
                    </h3>
                    <p>Arca dreams aloud: “If only life had transactions…”</p>
                    <p>
                        <a href="/episodes/episode-2">Read the Episode</a> ／
                        <a href="/playground/episode-2">Try in Playground</a>
                    </p>
                </article>
            </div>
        </div>
    </section>

    {/* LEARNING / WHAT YOU LEARN */}
    <section id="learning" class="fp-section js-fade">
        <div class="fp-section-inner">
            <h2 class="fp-heading">What you’ll learn here</h2>
            <ul class="fp-list">
                <li>How to form SQL questions starting from emotion</li>
                <li>How to translate daily frustrations into data questions</li>
                <li>
                    How to live gracefully with “ROLLBACK-worthy” past mistakes
                </li>
            </ul>
        </div>
    </section>

    {/* NEWS */}
    <section id="news" class="fp-section fp-section-alt js-fade">
        <div class="fp-section-inner">
            <h2 class="fp-heading">News</h2>
            <ul class="fp-news">
                <li>
                    <time datetime="2025-11-15">2025.11.15</time>
                    <span
                        >Episode 1 “SQL Begins with a Question” — coming soon.</span
                    >
                </li>
                <li>
                    <time datetime="2025-11-20">2025.11.20</time>
                    <span>Arca &amp; Nemi teaser visuals coming soon.</span>
                </li>
            </ul>
        </div>
    </section>
</BaseLayout>
