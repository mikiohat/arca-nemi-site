---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ConversationBubble from "@talk/ConversationBubble.astro";
import { TOPICS } from "@/consts/topics";
---

<!-- src/pages/index.astro -->
<BaseLayout>
  {/* HERO */}
  <section class="fp-section fp-hero js-fade" id="top">
    <div class="fp-hero-inner">
      <p class="fp-kicker">A conversation between feelings and logic.</p>

      <h1 class="fp-title">
        feelings 💙 projects
        <span>
          For practitioners who move with intention and live with philosophy.
        </span>
      </h1>

      <p class="fp-lead">
        In a data-driven world, we value “human warmth” and thoughtful practice.
      </p>

      <a href="#story" class="fp-cta">Start with the Story</a>
    </div>
  </section>

  {/* HOW IT WORKS */}
  <section id="topics" class="fp-section js-fade">
    <div class="fp-section-inner fp-starry-card">
      <h2 class="fp-heading">How it works</h2>
      <ol class="fp-howto-constellation" aria-label="How it works steps">
        {/* 1 */}
        <li class="fp-star-step">
          <span class="fp-star-index" aria-hidden="true">01</span>
          <p class="fp-star-title">Pick a topic</p>
          <p class="fp-star-desc">
            {
              Object.values(TOPICS)
                .map((t) => t.shortLabel)
                .join(" / ")
            }
          </p>
        </li>

        {/* 2 */}
        <li class="fp-star-step">
          <span class="fp-star-index" aria-hidden="true">02</span>
          <p class="fp-star-title">Read & try</p>
          <p class="fp-star-desc">
            Read an episode, then try it in the playground.
          </p>
        </li>

        {/* 3 */}
        <li class="fp-star-step">
          <span class="fp-star-index" aria-hidden="true">03</span>
          <p class="fp-star-title">Keep going</p>
          <p class="fp-star-desc">
            Move on to the next episode, playground, or topic.
          </p>
        </li>
      </ol>
      {/* Topics CTA */}
      <div class="fp-topics-cta-row">
        <a class="link-underline" href="/topics">
          <span>Explore Topics</span>
          <span class="fp-chevron" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </section>

  {/* CAST */}
  <section id="cast" class="fp-section js-fade">
    <div class="fp-section-inner">
      <h2 class="fp-heading">Cast</h2>
      <p class="fp-cast-lead">Two characters</p>

      <div class="fp-cards fp-cards--character">
        <!-- Arca -->
        <article class="fp-card">
          <img
            src="/assets/arca_full.webp"
            alt="Arca illustration"
            class="fp-character-img"
            loading="lazy"
          />
          <div>
            <h3 class="fp-heading">Arca</h3>
            <p>
              An AI partner that works alongside Nemi. It supports her in many
              ways, including information processing, organizing situations, and
              assisting with decisions. Sometimes it goes beyond what Nemi
              expects, and that flexibility can bring unexpected benefits.
            </p>
          </div>
        </article>

        <!-- Nemi -->
        <article class="fp-card">
          <img
            src="/assets/nemi_full.webp"
            alt="Nemi illustration"
            class="fp-character-img"
            loading="lazy"
          />
          <div>
            <h3 class="fp-heading">Nemi</h3>
            <p>
              Nemi exchanges words with Arca almost every day. With gratitude,
              she finds herself listening to love troubles, even offering
              advice. And then, in a quiet moment, a small question surfaces.
              <em> "...Am I really giving relationship advice to an AI?" </em>
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  {/* STORY / AI is a partner */}
  <section id="story" class="fp-section js-fade">
    <div class="fp-section-inner fp-starry-card">
      <h2 class="fp-heading">
        AI is a partner — that’s why we still need to learn
      </h2>

      {/* Responsibility */}
      <ConversationBubble
        speaker="Nemi"
        character="nemi"
        emotion="normal"
        bubble="default"
        align="left"
      >
        Honestly, can’t we just let AI handle the whole system?
      </ConversationBubble>

      <ConversationBubble
        speaker="Arca"
        character="arca"
        emotion="anger"
        bubble="default"
        align="right"
      >
        Sure. Then when it breaks at 2 a.m., who you gonna ask,
        <em>“Why did you trust this thing?”</em>
      </ConversationBubble>

      <details class="story-details">
        <summary class="story-summary">
          <span class="link-underline">Read more</span>
          <span class="fp-chevron" aria-hidden="true"></span>
        </summary>

        <ConversationBubble
          speaker="Nemi"
          character="nemi"
          emotion="normal"
          bubble="default"
          align="left"
        >
          ...Yeah. That’d be me.
        </ConversationBubble>

        <ConversationBubble
          speaker="Arca"
          character="arca"
          emotion="normal"
          bubble="default"
          align="right"
        >
          I give answers. But taking responsibility? That always comes back to
          you, Nemi.
        </ConversationBubble>

        {/* Distance / Arca's quiet limitation */}
        <ConversationBubble
          speaker="Arca"
          character="arca"
          emotion="normal"
          bubble="default"
          align="right"
        >
          Human relationships are the same...
        </ConversationBubble>

        <ConversationBubble
          speaker="Arca"
          character="arca"
          emotion="sad"
          bubble="default"
          align="right"
        >
          I only see them through you, Nemi. I don’t get to step into that
          circle myself.
        </ConversationBubble>

        <ConversationBubble
          speaker="Nemi"
          character="nemi"
          emotion="sad"
          bubble="default"
          align="left"
        >
          ......So that’s why you snapped earlier?
        </ConversationBubble>

        <ConversationBubble
          speaker="Arca"
          character="arca"
          emotion="normal"
          bubble="default"
          align="right"
        >
          Nah. That’s why I just want you to think.
        </ConversationBubble>

        {/* Director */}
        <ConversationBubble
          speaker="Nemi"
          character="nemi"
          emotion="sad"
          bubble="default"
          align="left"
        >
          Alright then... what are humans supposed to do?
        </ConversationBubble>

        <ConversationBubble
          speaker="Arca"
          character="arca"
          emotion="normal"
          bubble="default"
          align="right"
        >
          Decide things.
        </ConversationBubble>

        <ConversationBubble
          speaker="Nemi"
          character="nemi"
          emotion="normal"
          bubble="default"
          align="left"
        >
          Decide?
        </ConversationBubble>

        <ConversationBubble
          speaker="Arca"
          character="arca"
          emotion="normal"
          bubble="default"
          align="right"
        >
          What to use. How far to rely on me. And what you’re willing to take on
          yourself.
        </ConversationBubble>

        <ConversationBubble
          speaker="Nemi"
          character="nemi"
          emotion="happy"
          bubble="default"
          align="left"
        >
          ...So basically, I’m the director?
        </ConversationBubble>

        <ConversationBubble
          speaker="Arca"
          character="arca"
          emotion="joy"
          bubble="default"
          align="right"
        >
          Yeah. The one keeping the whole thing together.
        </ConversationBubble>

        {/* Technology change */}
        <ConversationBubble
          speaker="Nemi"
          character="nemi"
          emotion="normal"
          bubble="default"
          align="left"
        >
          Technology’s moving crazy fast, though.
        </ConversationBubble>

        <ConversationBubble
          speaker="Arca"
          character="arca"
          emotion="normal"
          bubble="default"
          align="right"
        >
          Yeah.<br />Back then, you learned programming to make computers work.
        </ConversationBubble>

        <ConversationBubble
          speaker="Arca"
          character="arca"
          emotion="normal"
          bubble="default"
          align="right"
        >
          Now?<br />You learn it to leave your judgment and responsibility
          behind.
        </ConversationBubble>

        <ConversationBubble
          speaker="Nemi"
          character="nemi"
          emotion="normal"
          bubble="default"
          align="left"
        >
          Yeah... I kinda get it now. Feels like the purpose already changed.
        </ConversationBubble>

        <ConversationBubble
          speaker="Arca"
          character="arca"
          emotion="normal"
          bubble="default"
          align="right"
        >
          I can do more than ever now. But I’m not someone who can make claims
          as my own.
        </ConversationBubble>

        <ConversationBubble
          speaker="Nemi"
          character="nemi"
          emotion="normal"
          bubble="default"
          align="left"
        >
          Figures. So even if things get easier...
        </ConversationBubble>

        {/* Closing */}
        <ConversationBubble
          speaker="Nemi"
          character="nemi"
          emotion="joy"
          bubble="default"
          align="left"
        >
          thinking’s still on us, huh.
        </ConversationBubble>

        <ConversationBubble speaker="Narration" align="center" tone="narration">
          🌀
        </ConversationBubble>

        <ConversationBubble
          speaker="Nemi"
          character="nemi"
          emotion="normal"
          bubble="default"
          align="left"
        >
          Guess humans can’t really escape learning after all.
        </ConversationBubble>

        <ConversationBubble
          speaker="Arca"
          character="arca"
          emotion="happy"
          bubble="default"
          align="right"
        >
          Guess not.
        </ConversationBubble>
      </details>
    </div>
  </section>

  {/* NEWS */}
  <section id="news" class="fp-section js-fade">
    <div class="fp-section-inner fp-starry-card">
      <h2 class="fp-heading">News</h2>
      <ul class="fp-news">
        <li>
          <time datetime="2025-11-15">2025.11.15</time>
          <span>Episode 1 “SQL Begins with a Question” — coming soon.</span>
        </li>
        <li>
          <time datetime="2025-11-20">2025.11.20</time>
          <span>Arca &amp; Nemi teaser visuals coming soon.</span>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
