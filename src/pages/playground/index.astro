---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SERIES } from "@/consts/series";
import Breadcrumbs from "@/components/nav/Breadcrumbs.astro";
---

<!-- src/pages/playground/index.astro -->
<BaseLayout title="Playground">
    <main class="fp-main">
        <section class="fp-section js-fade">
            <Breadcrumbs
                items={[{ label: "Home", href: "/" }, { label: "Playground" }]}
            />

            <div class="fp-cards">
                <!-- FEELINGS SQL -->
                <article class="fp-card">
                    <h1 class="fp-heading">{SERIES.FEELINGS_SQL.title}</h1>

                    <!-- 遊びながら、SQLの世界を探検してみよう。パズルを選んで、実行して、変化をのぞいてみよう。 -->
                    <p>
                        Explore the world of SQL through play.Pick a puzzle, run
                        it, and see what changes.
                    </p>

                    <p>
                        <a href={`/playground/${SERIES.FEELINGS_SQL.slug}`}
                            >Open SQL Playground →</a
                        >
                    </p>
                </article>

                <!-- FEELINGS Python -->
                <article class="fp-card">
                    <h1 class="fp-heading">{SERIES.FEELINGS_PYTHON.title}</h1>

                    <p>
                        A playful sandbox for tiny experiments. No lectures.
                        Just outcomes.
                    </p>

                    <p class="fp-muted">Coming soon…</p>
                </article>

                <!-- Data Design -->
                <article class="fp-card">
                    <h1 class="fp-heading">Data-Oriented App Design</h1>

                    <p>
                        Design as responsibility, explored through small models.
                        Observe structure, not slogans.
                    </p>

                    <p class="fp-muted">Coming soon…</p>
                </article>
            </div>
        </section>
    </main>
</BaseLayout>
