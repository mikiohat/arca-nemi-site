---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/nav/Breadcrumbs.astro";
import EpisodeRenderer from "@/components/episode/EpisodeRenderer.astro";
import ContentPager from "@/components/nav/ContentPager.astro";
import FloatingSwitcher from "@/components/nav/FloatingSwitcher.astro";

import { sqlLedger, type LedgerUnit } from "@/content/ledger/sql";
import { TOPICS } from "@/consts/topics";
import { formatEpisodeNumber } from "@/utils/format";
import { getSqlEpisodeLines } from "@/content/scripts/sql/sqlEpisodeRegistry";

// =======================
// static generation
// =======================
export function getStaticPaths() {
  const targets = sqlLedger.filter((e) => e.episode?.enabled !== "off");

  return targets.map((ledger) => ({
    params: { slug: ledger.slug },
    props: { ledger },
  }));
}

// =======================
// props
// =======================
type Props = {
  ledger: LedgerUnit;
};

const { ledger } = Astro.props as Props;
const slug = Astro.params.slug!;

// =======================
// script load
// =======================
const lines = await getSqlEpisodeLines(slug); // await は「呼ばれるまで待つ」じゃなく、「結果が返るまで待つ」。
const isMissingScript = !lines;

// =======================
// prev / next
// =======================
const navigable = sqlLedger
  .filter((e) => e.episode?.enabled !== "off")
  .sort((a, b) => a.order - b.order);

const idx = navigable.findIndex((e) => e.slug === slug);
const prevLedger = idx > 0 ? navigable[idx - 1] : null;
const nextLedger =
  idx >= 0 && idx < navigable.length - 1 ? navigable[idx + 1] : null;

const toEpisodeHref = (s: string) => `/topics/${TOPICS.SQL.slug}/episode/${s}`;

const prev = prevLedger
  ? { href: toEpisodeHref(prevLedger.slug), title: prevLedger.title }
  : null;

const next = nextLedger
  ? { href: toEpisodeHref(nextLedger.slug), title: nextLedger.title }
  : null;

const top = {
  href: `/topics/${TOPICS.SQL.slug}`,
  label: `${TOPICS.SQL.shortLabel} Home`,
};

// =======================
// epi / play
// =======================
const episodeHref = (s: string) => `/topics/${TOPICS.SQL.slug}/episode/${s}`;
const playgroundHref = (s: string) =>
  `/topics/${TOPICS.SQL.slug}/playground/${s}`;

const switchLeft = {
  label: "Episode",
  href: episodeHref(slug),
};

const switchRight = {
  label: "Playground",
  href: playgroundHref(slug),
};
---

<BaseLayout title={ledger.title} description={ledger.description}>
  <section class="fp-section js-fade">
    {/* ===== Breadcrumbs : 構造の責務 ===== */}
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Topics", href: "/topics" },
        {
          label: TOPICS.SQL.title,
          href: `/topics/${TOPICS.SQL.slug}`,
        },
        {
          label: formatEpisodeNumber(ledger.order),
        },
      ]}
    />

    {/* ===== Episode content ===== */}
    {
      isMissingScript ? (
        <>
          <h1 class="fp-title">{ledger.title}</h1>
          {ledger.episode?.subtitle && (
            <p class="fp-subtitle">{ledger.episode.subtitle}</p>
          )}

          <p class="fp-lead" style="margin-top: 1.5rem;">
            This episode is still forming in the night sky. 🌙
          </p>
        </>
      ) : (
        <EpisodeRenderer ledger={ledger} lines={lines} />
      )
    }
    {/* ===== Prev / Next ===== */}
    <ContentPager prev={prev} next={next} top={top} />
  </section>
  {/* ===== epi / play ===== */}
  <FloatingSwitcher left={switchLeft} right={switchRight} active="left" />
</BaseLayout>
