---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/nav/Breadcrumbs.astro";
import StoryRenderer from "@/components/story/StoryRenderer.astro";
import ContentPager from "@/components/nav/ContentPager.astro";
import FloatingSwitcher from "@/components/nav/FloatingSwitcher.astro";

import { sqlLedger, type LedgerUnit } from "@/content/ledger/sql";
import { TOPICS } from "@/consts/topics";
import { formatStoryNumber } from "@/utils/format";
import { getSqlStoryLines } from "@/content/scripts/sql/sqlStoryRegistry";

// =======================
// static generation
// =======================
export function getStaticPaths() {
  const targets = sqlLedger.filter((e) => e.story?.enabled == "live");

  return targets.map((ledger) => ({
    params: { slug: ledger.slug },
    props: { ledger },
  }));
}

// =======================
// props
// =======================
type Props = {
  ledger: LedgerUnit;
};

const { ledger } = Astro.props as Props;
const slug = Astro.params.slug!;

// =======================
// script load
// =======================
const lines = await getSqlStoryLines(slug); // await は「呼ばれるまで待つ」じゃなく、「結果が返るまで待つ」。
const isMissingScript = !lines;

// =======================
// prev / next
// =======================
const navigable = sqlLedger
  .filter((e) => e.story?.enabled == "live")
  .sort((a, b) => a.order - b.order);

const idx = navigable.findIndex((e) => e.slug === slug);
const prevLedger = idx > 0 ? navigable[idx - 1] : null;
const nextLedger =
  idx >= 0 && idx < navigable.length - 1 ? navigable[idx + 1] : null;

const toStoryHref = (s: string) => `/topics/${TOPICS.SQL.slug}/stories/${s}`;

const prev = prevLedger
  ? { href: toStoryHref(prevLedger.slug), title: prevLedger.title }
  : null;

const next = nextLedger
  ? { href: toStoryHref(nextLedger.slug), title: nextLedger.title }
  : null;

const top = {
  href: `/topics/${TOPICS.SQL.slug}/stories`,
  label: `${TOPICS.SQL.shortLabel} Stories`,
};

// =======================
// story / lab switch
// =======================
const storyHref = (s: string) => `/topics/${TOPICS.SQL.slug}/stories/${s}`;
const labHref = (s: string) => `/topics/${TOPICS.SQL.slug}/lab/${s}`;

const switchLeft = {
  label: "Story",
  href: storyHref(slug),
};

const switchRight = {
  label: "Lab",
  href: labHref(slug),
};
---

<BaseLayout title={ledger.title} description={ledger.description}>
  <section class="fp-section js-fade">
    {/* ===== Breadcrumbs : 構造の責務 ===== */}
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Topics", href: "/topics" },
        {
          label: TOPICS.SQL.title,
          href: `/topics/${TOPICS.SQL.slug}`,
        },
        {
          label: "Stories",
          href: `/topics/${TOPICS.SQL.slug}/stories`,
        },
        {
          label: formatStoryNumber(ledger.order),
        },
      ]}
    />

    {/* ===== Story content ===== */}
    {
      isMissingScript ? (
        <>
          <h1 class="fp-title">{ledger.title}</h1>
          {ledger.story?.subtitle && (
            <p class="fp-subtitle">{ledger.story.subtitle}</p>
          )}

          <p class="fp-lead" style="margin-top: 1.5rem;">
            This story is still forming in the night sky. 🌙
          </p>
        </>
      ) : (
        <StoryRenderer ledger={ledger} lines={lines} />
      )
    }
    {/* ===== Prev / Next ===== */}
    <ContentPager prev={prev} next={next} top={top} />
  </section>
  {/* ===== story / lab ===== */}
  <FloatingSwitcher left={switchLeft} right={switchRight} active="left" />
</BaseLayout>
