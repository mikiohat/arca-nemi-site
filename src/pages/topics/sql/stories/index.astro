---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/nav/Breadcrumbs.astro";
import LedgerIndex from "@/components/ledger/LedgerIndex.astro";
import { TOPICS } from "@/consts/topics.ts";
import { sqlLedger } from "@/content/ledger/sql";

const stories = sqlLedger.filter((u) => u.story?.enabled !== "off");
---

<BaseLayout
  title={`${TOPICS.SQL.title} Stories`}
  description={TOPICS.SQL.description}
>
  <main class="fp-main">
    <section class="fp-section js-fade">
      <Breadcrumbs
        items={[
          { label: "Home", href: "/" },
          { label: "Topics", href: "/topics" },
          { label: TOPICS.SQL.shortLabel, href: `/topics/${TOPICS.SQL.slug}` },
          { label: "Stories" },
        ]}
      />

      <h1 class="fp-heading-soft">{TOPICS.SQL.summary}</h1>

      <LedgerIndex topicSlug={TOPICS.SQL.slug} ledgers={stories} />
    </section>
  </main>
</BaseLayout>
