---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/nav/Breadcrumbs.astro";
import UnderConstruction from "@/components/common/UnderConstruction.astro";
import { TOPICS } from "@/consts/topics.ts";
---

<BaseLayout title={`${TOPICS.SQL.title} Lab`} description={TOPICS.SQL.description}>
  <main class="fp-main">
    <section class="fp-section js-fade">
      <Breadcrumbs
        items={[
          { label: "Home", href: "/" },
          { label: "Topics", href: "/topics" },
          { label: TOPICS.SQL.shortLabel, href: `/topics/${TOPICS.SQL.slug}` },
          { label: "Lab" },
        ]}
      />

      <UnderConstruction
        title={`${TOPICS.SQL.shortLabel} Lab 🛠️`}
        subtitle="Hands-on SQL experiments."
        message="The lab is still under construction. Hands-on experiments are coming soon — for now, enjoy the stories."
        fallbackHref="/topics"
      />
    </section>
  </main>
</BaseLayout>
