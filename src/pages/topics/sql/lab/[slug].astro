---
import { sqlLedger } from "@/content/ledger/sql";

export function getStaticPaths() {
  const slugs = sqlLedger
    .filter((e) => e.story?.enabled !== "off")
    .map((e) => e.slug);

  return slugs.map((slug) => ({ params: { slug } }));
}

return Astro.redirect("/under-construction", 302);
---
