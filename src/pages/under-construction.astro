---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/nav/Breadcrumbs.astro";
import UnderConstruction from "@/components/common/UnderConstruction.astro";
---

<BaseLayout
  title="Under Construction"
  description="This area is still being built."
>
  <main class="fp-main">
    <section class="fp-section js-fade">
      <Breadcrumbs
        items={[{ label: "Home", href: "/" }, { label: "Under Construction" }]}
      />

      <UnderConstruction fallbackHref="/topics" />
    </section>
  </main>
</BaseLayout>
